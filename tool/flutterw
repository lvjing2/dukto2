#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "$0")/.." && pwd)"
if [[ -n "${FLUTTER_BIN:-}" ]]; then
  flutter_bin="$FLUTTER_BIN"
elif command -v flutter >/dev/null 2>&1; then
  flutter_bin="$(command -v flutter)"
else
  flutter_bin="$project_root/../.toolchains/flutter/bin/flutter"
fi
if [[ ! -x "$flutter_bin" ]]; then
  echo 'Install Flutter stable, or set FLUTTER_BIN to its executable.' >&2
  exit 1
fi
if [[ -z "${ANDROID_HOME:-}" && -d "$project_root/../.toolchains/android-sdk" ]]; then
  export ANDROID_HOME="$project_root/../.toolchains/android-sdk"
  export ANDROID_SDK_ROOT="$ANDROID_HOME"
fi
cd "$project_root"
exec "$flutter_bin" "$@"
